  Cache-Control: public, max-age=1209600

/favicon.svg
  Cache-Control: public, max-age=1209600

/icon-192.svg
  Cache-Control: public, max-age=1209600

/icon-512.svg
  Cache-Control: public, max-age=1209600

/apple-touch-icon.png
